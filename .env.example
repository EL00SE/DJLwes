# Copy this file to .env and fill in real values.

# Postgres connection string.
# Matches docker-compose.yml if you're running Postgres locally via Docker:
DATABASE_URL="postgresql://djlwes:djlwes@localhost:5432/djlwes"

# Stripe (test mode) — from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# From `stripe listen --print-secret` (local) or the Stripe Dashboard
# webhook endpoint you configure for /api/webhooks/stripe (production)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Base URL used to build Stripe success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
