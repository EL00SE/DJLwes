# Copy this file to .env and fill in real values.

# Postgres connection string.
# Matches docker-compose.yml if you're running Postgres locally via Docker:
DATABASE_URL="postgresql://djlwes:djlwes@localhost:5432/djlwes"

# PayPal (sandbox/test) — from a sandbox app at
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-sandbox-client-secret"
# "sandbox" for testing (default), "live" once you're ready for real payments.
PAYPAL_ENV="sandbox"
# From registering a webhook at that same app — see README's "PayPal
# webhook setup". Without this, /api/webhooks/paypal refuses every request.
PAYPAL_WEBHOOK_ID="your-webhook-id"
# Same client id as PAYPAL_CLIENT_ID, exposed to the browser for the
# embedded PayPal/Venmo/Apple Pay/Google Pay buttons (client ids are meant
# to be public, same as a Stripe publishable key). Mirror PAYPAL_ENV here
# too — see README's "Apple Pay / Google Pay setup" for the rest of what
# those two need beyond this.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-sandbox-client-id"
NEXT_PUBLIC_PAYPAL_ENV="sandbox"

# Base URL used for absolute links this app builds itself (OG images,
# WhatsApp ticket links, entrance-QR check-in URLs). Not needed on Vercel
# (auto-detected there) — only set this for local dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend (email ticket confirmations) — from https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Optional. Defaults to Resend's shared sandbox sender, which works with
# no setup. Switch to your own verified domain once you have one, e.g.
# "Etfe El Boiler <tickets@yourdomain.com>".
RESEND_FROM_EMAIL="Etfe El Boiler <onboarding@resend.dev>"

# WhatsApp Business Cloud API (WhatsApp ticket confirmations) — from a
# Meta for Developers app: https://developers.facebook.com/apps
WHATSAPP_ACCESS_TOKEN="your-permanent-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
# The name of the pre-approved message template to send. See README for
# the exact text to submit to Meta for approval.
WHATSAPP_TEMPLATE_NAME="ticket_confirmation"

# Green Invoice (official receipts) — from app.greeninvoice.co.il →
# Settings → API Keys. Optional; without these, approving an order skips
# receipt issuance and /admin shows a "Retry receipt" button instead.
GREEN_INVOICE_API_KEY="your-api-key-id"
GREEN_INVOICE_API_SECRET="your-api-key-secret"
# "true" (default) issues receipts against Green Invoice's free sandbox —
# safe for testing. Set to "false" only once you're ready to issue real,
# legally-binding receipts.
GREEN_INVOICE_SANDBOX="true"

# Password for the /admin order-approval page. Pick something real —
# this is the only thing standing between the internet and your orders.
ADMIN_PASSWORD="change-me"
