// Prisma schema for the DJ Lwes / Etfe El Boiler ticketing site.
// Run `npx prisma migrate dev` after setting DATABASE_URL to apply this.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single event (party). Only one event should be marked `isActive` at a
/// time — that's the one shown on the homepage. Everything else shows up
/// under "Past Events" once its date has passed.
model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  date        DateTime
  location    String
  coverImage  String
  /// CSS object-position value ("50% 50%" = centered) for coverImage —
  /// lets the admin choose what stays in frame when the same photo gets
  /// cropped differently across the site (portrait hero, wide hero,
  /// square gallery tiles) instead of always center-cropping.
  coverImageFocalPoint String  @default("50% 50%")
  isActive             Boolean @default(false)

  /// External checkout link for this event (a Grow-hosted payment page —
  /// Grow owns pricing/quantity/invoicing from here). Null until the admin
  /// sets one; the homepage shows a disabled "coming soon" button until then.
  buyLink String?

  /// Freeform support-act list, one per line (e.g. "Nadia K\nJonas R").
  /// Null/empty hides the lineup block on the homepage entirely.
  lineup String?

  /// Freeform entry/door requirements, one per line (e.g. "Mixed groups
  /// only after 1am", "Valid ID required", "21+"). Shown to buyers before
  /// they click through to Grow, since Grow's own checkout page doesn't
  /// carry this context. Null/empty hides the section entirely.
  entryRequirements String?

  /// A short disclaimer shown just under the Buy Tickets button (e.g. "All
  /// sales are final — no refunds or transfers"). One free-text paragraph,
  /// not a list like entryRequirements. Null/empty hides it entirely.
  buyDisclaimer String?

  ticketTypes   TicketType[]
  galleryItems  GalleryItem[]
  orders        Order[]
  guestRequests GuestRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([date])
}

/// A tier of ticket for an event (e.g. "Early Bird", "General Admission").
/// `quantityRemaining` is decremented atomically when an order is paid.
model TicketType {
  id                String @id @default(cuid())
  eventId           String
  name              String
  description       String?
  priceCents        Int
  quantityTotal     Int
  quantityRemaining Int

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

/// A photo or video shown in the past-events gallery for a given event.
model GalleryItem {
  id      String          @id @default(cuid())
  eventId String
  type    GalleryItemType
  url     String
  caption String?
  sortOrder Int           @default(0)
  /// CSS object-position value ("50% 50%" = centered) — see
  /// Event.coverImageFocalPoint for why this exists.
  focalPoint String @default("50% 50%")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId])
}

enum OrderStatus {
  PENDING
  /// Payment captured, inventory reserved — awaiting the business owner's
  /// approval in /admin before the ticket is actually sent.
  PAID
  /// The business owner approved the order in /admin; the ticket
  /// confirmation has been (or is about to be) sent.
  CONFIRMED
  CANCELED
  /// Paid on PayPal but couldn't be fulfilled (lost a race for the last
  /// ticket) and the automatic refund attempt itself failed — needs a
  /// human to refund manually.
  FAILED
  /// Either the last-ticket race was lost, or the business owner declined
  /// the order in /admin — either way, refunded and inventory released.
  REFUNDED
}

/// One checkout attempt/purchase. Created as PENDING when the buyer starts
/// checkout, flipped to PAID once their PayPal order is captured (ticket
/// quantities are decremented at that point), then to CONFIRMED or
/// REFUNDED once the business owner reviews it in /admin.
model Order {
  id           String @id @default(cuid())
  eventId      String
  customerName String

  /// Required at checkout — used by the business owner to vet buyers
  /// before approving an order in /admin.
  customerInstagram String

  /// Exactly one of these is set — the buyer picks email or WhatsApp as
  /// their delivery method at checkout (enforced in the API route and by
  /// a DB check constraint in the migration, since Prisma has no native
  /// "at least one of" column constraint).
  customerEmail String?
  customerPhone String?

  status OrderStatus @default(PENDING)

  /// Set once the order-confirmation email/WhatsApp message has actually
  /// been sent (on admin approval), so it's never sent twice.
  confirmationSentAt DateTime?

  paypalOrderId   String? @unique
  paypalCaptureId String? @unique

  totalCents Int

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([customerEmail])
}

/// Records every incoming PayPal webhook request, verified or not. Exists
/// because this app has no access to Vercel's own request logs — this is
/// the only way to see, after the fact, exactly what PayPal's signature
/// verification API actually said about a real delivery.
model WebhookLog {
  id             String   @id @default(cuid())
  eventType      String?
  transmissionId String?
  verified       Boolean
  detail         String
  createdAt      DateTime @default(now())
}

enum GuestRequestStatus {
  PENDING
  /// Approved in /admin. A Grow payment link should have been generated
  /// and sent — see growPaymentLinkUrl/growPaymentLinkSentAt. Payment
  /// itself, and invoicing, happen entirely on Grow's side from here.
  APPROVED
  DECLINED
}

/// The "guest list" request flow: a customer asks to attend (with a
/// headcount broken down by gender, since door policy/pricing here
/// depends on that) before any payment happens. The business owner vets
/// and approves/declines in /admin; approving sends the guest a Grow
/// payment link, and Grow handles collecting payment and issuing real
/// invoices to both the guest and the business — this app never touches
/// money for this flow the way it does for Order/PayPal.
model GuestRequest {
  id      String @id @default(cuid())
  eventId String

  customerName      String
  customerInstagram String
  /// Required — this is what Grow uses to deliver the payment link.
  customerPhone String
  customerEmail String?

  maleCount   Int @default(0)
  femaleCount Int @default(0)
  otherCount  Int @default(0)

  status GuestRequestStatus @default(PENDING)

  /// Set once a Grow payment link has actually been created + sent for
  /// this request (on approval). Null until that integration is wired up.
  growPaymentLinkUrl    String?
  growPaymentLinkSentAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([status])
}

/// A line item within an order — a quantity of one ticket type, at the
/// price it was purchased at (kept separately from TicketType.priceCents
/// in case the price changes later).
model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPriceCents Int

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@index([ticketTypeId])
}

/// Singleton row holding the homepage's "About" section content — the one
/// piece of site-wide (not per-event) content the admin edits. Always
/// exactly one row, at the fixed id below; see src/lib/about-content.ts.
/// Socials and the SoundCloud embed stay in src/lib/site-content.ts for
/// now (they change far less often than the bio/photos do).
model AboutContent {
  id        String   @id @default("about")
  bio       String
  /// Blob URLs, admin-uploaded — shown as a small photo grid next to the
  /// bio. Empty hides the photo grid entirely (bio still shows).
  photos    String[] @default([])
  updatedAt DateTime @updatedAt
}

/// An email captured from the homepage's "notify me" form, shown whenever
/// there's no active event to buy tickets for. No follow-up automation
/// exists yet — this just gives the business owner a list to email by
/// hand when the next event is announced.
model NotifySignup {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Submitter's IP, used only to throttle a single source spamming this
  /// public, unauthenticated form — never displayed or exported. Nullable
  /// since it can't always be determined (and older rows predate this
  /// column).
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}
